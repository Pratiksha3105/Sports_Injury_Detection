# ============================================================================
# Sports Injury Risk Detection — Environment Variables
# ============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# This project has two services, each with its own env file too
# (backend/.env.example, frontend/.env.example) in case you prefer to run
# them independently. The values below are the same variables, collected
# here for convenience when running everything from the repo root
# (e.g. with docker-compose).
# ============================================================================

# ---- Backend (FastAPI / AI core) ------------------------------------------

# Host/port the FastAPI server binds to.
HOST=0.0.0.0
PORT=8000

# Comma-separated list of origins allowed to call the API (CORS).
# In production, set this to your deployed frontend URL(s) instead of "*".
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Frontend (React / Vite) -----------------------------------------------

# Base URL the frontend uses to reach the backend API.
# Must be reachable from the browser (not just from inside a container).
VITE_API_BASE_URL=http://localhost:8000
