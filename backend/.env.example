# Sports Injury Risk Detection — Backend (AI Core) environment variables
# Copy to .env: cp .env.example .env

# Host/port the FastAPI server binds to (used by start_project scripts / docker-compose).
HOST=0.0.0.0
PORT=8000

# Comma-separated list of origins allowed to call the API (CORS).
# In production, set this to your deployed frontend URL(s) instead of "*".
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Authentication & RBAC -----------------------------------------------
# Generate a strong secret in production, e.g.: openssl rand -hex 32
AUTH_SECRET_KEY=dev-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_HOURS=48

# Set to "true" once served over HTTPS in production (required for the
# refresh-token cookie's Secure flag).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# SQLite by default — zero setup. Point this at Postgres/MySQL in prod, e.g.
# postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./storage/app.db

# Optional: auto-create an admin account on first startup.
# Leave both unset to skip bootstrap and create the first admin manually
# (e.g. temporarily register as coach/athlete then promote via direct DB
# edit, or set these two vars once and restart the server).
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!

# --- AI assistant ("Ask AI" on a report) ----------------------------------
# Optional. Without this set, the /chat endpoints return 503 with a clear
# message instead of failing unexpectedly. Get a key at
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
